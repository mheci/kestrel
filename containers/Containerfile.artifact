# The kestrel artifact image. Not bootable on its own: a payload to COPY
# from. Everything lives under paths a consumer can copy with one COPY.
#
#   /rpms/*.rpm                      kestrel-kernel, -devel, -nvidia-kmod
#   /usr/libexec/kestrel-install     installer (see its header)
#   /usr/share/kestrel/manifest.json provenance
#   /usr/share/kestrel/kestrel.crt   module and vmlinuz signing certificate (PEM)
#   /usr/share/kestrel/kestrel.der   the same, DER, for `mokutil --import`
#   /usr/share/kestrel/RPM-GPG-KEY-kestrel  OpenPGP key the RPMs are signed with
#   /usr/share/kestrel/LICENSES/
FROM scratch
ARG KESTREL_CHANNEL
ARG KESTREL_KVER
ARG KESTREL_NVIDIA
ARG KESTREL_BUILD_ID
COPY out/rpms/ /rpms/
COPY out/manifest.json out/kestrel.crt out/kestrel.der out/RPM-GPG-KEY-kestrel /usr/share/kestrel/
COPY out/LICENSES/ /usr/share/kestrel/LICENSES/
COPY containers/kestrel-install /usr/libexec/kestrel-install
LABEL org.opencontainers.image.title="kestrel ${KESTREL_CHANNEL}" \
      org.opencontainers.image.description="CachyOS kernel ${KESTREL_KVER} with NVIDIA open modules ${KESTREL_NVIDIA} for bootc images" \
      org.opencontainers.image.source="https://github.com/mheci/kestrel" \
      org.opencontainers.image.licenses="Apache-2.0 AND GPL-2.0-only AND MIT" \
      io.kestrel.channel="${KESTREL_CHANNEL}" \
      io.kestrel.kver="${KESTREL_KVER}" \
      io.kestrel.nvidia="${KESTREL_NVIDIA}" \
      io.kestrel.build_id="${KESTREL_BUILD_ID}"
