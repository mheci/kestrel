# Reference consumer: the image kestrel boots in CI to prove the artifact.
#
# Base follows the same image the resolver read the Fedora release from,
# NVIDIA userspace comes from Terra at the version the modules were built
# for, then kestrel-install swaps the kernel. Nothing else.
ARG BASE_IMAGE=ghcr.io/ublue-os/kinoite-main:latest
ARG KESTREL_IMAGE=localhost/kestrel:build
ARG NVIDIA_VERSION
ARG FEDORA_RELEASE

FROM ${KESTREL_IMAGE} AS kestrel

FROM ${BASE_IMAGE}
ARG NVIDIA_VERSION
ARG FEDORA_RELEASE
COPY --from=kestrel / /tmp/kestrel

# Terra userspace at exactly the module version. The base ships
# nvidia-gpu-firmware (linux-firmware split) which is unrelated to the driver.
RUN set -euo pipefail; \
    dnf5 -y install --nogpgcheck \
      --repofrompath "terra,https://repos.fyralabs.com/terra${FEDORA_RELEASE}" \
      terra-release >/dev/null; \
    dnf5 -y install --enablerepo=terra terra-release-nvidia >/dev/null; \
    rpm --import /tmp/kestrel/usr/share/kestrel/RPM-GPG-KEY-kestrel; \
    dnf5 -y install --enablerepo=terra-nvidia --setopt=install_weak_deps=False \
      --exclude=akmod-nvidia,kmod-nvidia \
      "nvidia-driver-${NVIDIA_VERSION}" \
      "nvidia-driver-libs-${NVIDIA_VERSION}" \
      "nvidia-kmod-common-${NVIDIA_VERSION}" \
      "nvidia-driver-cuda-${NVIDIA_VERSION}" \
      nvidia-modprobe nvidia-driver-selinux \
      /tmp/kestrel/rpms/kestrel-nvidia-kmod-*.rpm; \
    rpm -q nvidia-driver nvidia-kmod-common kestrel-nvidia-kmod; \
    rpm -q akmod-nvidia kmod-nvidia >/dev/null 2>&1 && exit 1 || true

RUN /tmp/kestrel/usr/libexec/kestrel-install && rm -rf /tmp/kestrel

# What a real consumer adds for NVIDIA: modeset on, and the driver in the
# initramfs is handled by Terra's 99-nvidia.conf dracut drop-in.
RUN set -euo pipefail; \
    mkdir -p /usr/lib/bootc/kargs.d; \
    printf 'kargs = ["rd.driver.blacklist=nouveau", "modprobe.blacklist=nouveau", "nvidia-drm.modeset=1", "module.sig_enforce=1"]\n' \
      >/usr/lib/bootc/kargs.d/10-kestrel-reference.toml; \
    dnf5 clean all; rm -rf /var/cache/* /var/log/* /var/lib/dnf* /tmp/*; \
    mkdir -p /var/tmp; \
    bootc container lint
